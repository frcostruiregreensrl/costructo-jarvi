# Esempio di configurazione di Jarvis. Copia in .env (che NON va mai nel repository) e compila.
# Nessun valore qui sotto è reale.

# Ambiente
NODE_ENV=development
PORT=4180
# Indirizzi da cui si apre l'app (controllo Origin/Host). In produzione solo https.
JARVIS_ORIGINE=http://localhost:4180,http://127.0.0.1:4180
# Cartella dei dati (database SQLite data/jarvis.db)
JARVIS_DATI=data
# 1 se il server sta dietro un proxy (es. Railway), per leggere l'IP vero nel limite tentativi
JARVIS_PROXY=0
JARVIS_FUSO=Europe/Rome

# Chiave per cifrare i segreti nel database: 32 byte in hex o base64.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JARVIS_CHIAVE_CIFRATURA=

# Claude (Anthropic). Modello di tutti i giorni e modello «pensaci bene».
ANTHROPIC_API_KEY=
JARVIS_MODELLO=claude-haiku-5-5
JARVIS_MODELLO_APPROFONDITO=claude-sonnet-5-5

# Costructo (sola lettura). Si possono impostare anche dalla pagina Impostazioni (salvati cifrati).
COSTRUCTO_URL=
COSTRUCTO_TOKEN=

# Notifiche push (briefing del mattino). Genera le chiavi con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTATTO=mailto:assistenza@example.invalid
