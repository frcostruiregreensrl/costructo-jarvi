{
  "name": "costructo-jarvis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "COSTRUCTO J.A.R.V.I.S. — assistente personale di Luigi (Fase 1: nucleo)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js && esbuild src/cervello/anthropic.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/anthropic.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:interfaccia": "node script/prova-interfaccia.mjs",
    "crea-utente": "tsx src/cli/creaUtente.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "better-sqlite3": "11.10.0",
    "express": "5.2.1",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "nodemailer": "10.3.1",
    "three": "0.187.0",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "20.19.27",
    "esbuild": "0.25.12",
    "tsx": "4.21.0",
    "typescript": "5.6.3"
  }
}
